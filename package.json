    "api": "npm run dev -w @esmart/api"
  },
  "devDependencies": {
    "@esmart/eslint-config": "*",
    "eslint": "^9.39.5",
    "railway": "^3.12.0",
    "turbo": "^2.11.5"
  },
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~57.0.23",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
