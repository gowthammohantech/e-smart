{
  "name": "e-smart",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "mobile": "npm run start -w @esmart/mobile",
    "web": "npm run start -w @esmart/web",
    "api": "npm run dev -w @esmart/api"
  },
  "devDependencies": {
    "turbo": "^2.11.5",
    "eslint": "^9.39.5",
    "@esmart/eslint-config": "*"
  },
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22"
  }
}
