{
  "name": "e-smart",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:tools": "node --test tools/static-server.test.mjs",
    "audit": "node tools/audit.mjs",
    "check:migrations": "node tools/check-migrations.mjs",
    "mobile": "npm run start -w @esmart/mobile",
    "web": "npm run start -w @esmart/web",
    "admin": "npm run dev -w @esmart/admin",
    "api": "npm run dev -w @esmart/api",
    "site": "npm run dev -w @esmart/site",
    "desktop": "npm run tauri:dev -w @esmart/desktop",
    "desktop:build": "npm run tauri:build -w @esmart/desktop"
  },
  "devDependencies": {
    "@esmart/eslint-config": "*",
    "eslint": "^10.14.0",
    "railway": "^3.12.0",
    "turbo": "^2.11.5"
  },
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~57.0.23",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
