{
  "name": "@esmart/site",
  "version": "0.0.0",
  "private": true,
  "description": "Marketing site for Elixir Books Smart: a static Next.js export.",
  "scripts": {
    "predev": "node scripts/copy-brand.mjs",
    "dev": "next dev -p 3100",
    "prebuild": "node scripts/copy-brand.mjs",
    "build": "next build",
    "start": "sirv out --host 0.0.0.0 --port ${PORT:-3100}",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@esmart/core": "*",
    "@esmart/i18n": "*",
    "@esmart/ui": "*",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "lenis": "1.3.27",
    "lucide-react": "1.55.0",
    "motion": "14.7.1",
    "next": "16.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sirv-cli": "3.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@esmart/eslint-config": "*",
    "@esmart/tsconfig": "*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "@types/three": "0.186.0",
    "eslint": "^9.39.5",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3"
  }
}
