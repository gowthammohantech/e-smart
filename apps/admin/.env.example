# The API origin, without /v1.
VITE_API_URL=http://localhost:4000

# Prefill the sign-in form. Vite compiles these into the bundle, readable by
# anyone who loads the page: set them only on a demo or sandbox deployment,
# never on production. Unset, the form starts empty.
# VITE_DEMO_LOGIN_EMAIL=
# VITE_DEMO_LOGIN_PASSWORD=
