{
  "name": "@esmart/admin",
  "version": "0.0.0",
  "private": true,
  "description": "Platform admin console for operators: tenants, users, plans, metrics and the operator audit log.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "sirv dist --single --host 0.0.0.0 --port ${PORT:-5174}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@esmart/api-client": "*",
    "@esmart/api-contract": "*",
    "@esmart/core": "*",
    "@esmart/ui": "*",
    "@tanstack/react-query": "5.103.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "7.18.4",
    "recharts": "3.10.1",
    "sirv-cli": "3.0.1"
  },
  "devDependencies": {
    "@esmart/eslint-config": "*",
    "@esmart/tsconfig": "*",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.39.5",
    "jsdom": "30.1.1",
    "typescript": "~6.0.3",
    "vite": "8.3.1",
    "vitest": "^5.0.2"
  }
}
