    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@esmart/api-client": "*",
    "@esmart/api-contract": "*",
    "@esmart/core": "*",
    "@esmart/ui": "*",
    "@tanstack/react-query": "5.106.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@esmart/eslint-config": "*",
    "@esmart/tsconfig": "*",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/qrcode": "1.5.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "^9.39.5",
    "jsdom": "30.1.1",
    "typescript": "~6.0.3",
    "vite": "8.3.6",
    "vitest": "^5.1.0"
