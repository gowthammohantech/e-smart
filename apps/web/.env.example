# Copy to .env. Expo inlines EXPO_PUBLIC_* at build time, so a change needs a
# fresh build: restart with `expo start --clear` (or `expo export --clear`),
# because Metro's cache otherwise keeps the old values.

# The API origin, without /v1. The app always talks to the API.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Prefill the sign-in form. These are compiled into the client bundle and
# readable by anyone who loads it: set them only on a demo or sandbox build
# whose account is a throwaway (SEED_DEMO_ACCOUNT on the API), never on
# production. Unset, the form starts empty.
# EXPO_PUBLIC_DEMO_LOGIN_EMAIL=
# EXPO_PUBLIC_DEMO_LOGIN_PASSWORD=

# Admit NIC's sandbox GSTIN shape (29AAGCB1286Q000) in the app's own checks, e.g. the e-invoice sheet.
# Sandbox builds only; match the API's TAXATION_GSTIN_ALLOW_SANDBOX.
# EXPO_PUBLIC_TAXATION_GSTIN_ALLOW_SANDBOX=true

# Product analytics (PostHog Cloud, EU). Unset: the app sends nothing. The key is a public project key.
# The web server (serve.mjs) adds the host to the Content-Security-Policy when the key is set.
# EXPO_PUBLIC_POSTHOG_KEY=phc_
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
