# Copy to .env; `npm run dev` loads it. Everything has a development default,
# so an empty .env works against the docker-compose Postgres.
DATABASE_URL=postgres://esmart:esmart@localhost:5432/esmart
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
# The web app: password-reset and invitation links open here.
APP_URL=http://localhost:8081
CORS_ORIGINS=*
# Accept 123456 as the OTP, as the prototype does. Development only.
DEMO_OTP=true

# Production must set these.
# JWT_SECRET=
# CREDENTIALS_KEY=   # 32 random bytes, base64: openssl rand -base64 32

# Providers default to in-process simulators. Switch one at a time:
# SMS_PROVIDER=msg91        MSG91_AUTH_KEY=  MSG91_TEMPLATE_ID=
# EMAIL_PROVIDER=ses        EMAIL_FROM=
# WHATSAPP_PROVIDER=meta    WHATSAPP_TOKEN=  WHATSAPP_PHONE_NUMBER_ID=
# PUSH_PROVIDER=expo
# STORAGE_PROVIDER=s3       S3_BUCKET=  S3_REGION=  S3_ENDPOINT=  S3_FORCE_PATH_STYLE=
# PDF_PROVIDER=chromium     CHROMIUM_PATH=
# COMPLIANCE_PROVIDER=gsp   GSP_BASE_URL=
# GSTIN_PROVIDER=gsp
# OCR_PROVIDER=document-ai
# FX_PROVIDER=openexchangerates  OPENEXCHANGERATES_APP_ID=
# PAYMENTS_PROVIDER=razorpay     RAZORPAY_KEY_ID=  RAZORPAY_KEY_SECRET=  RAZORPAY_WEBHOOK_SECRET=
# ASSISTANT_PROVIDER=anthropic  ANTHROPIC_API_KEY=  LIXI_MODEL=claude-opus-5-5  LIXI_EFFORT=low
