# Copy to .env; `npm run dev` loads it, and so do the @esmart/db scripts.
# Everything has a development default, so an empty .env works against the
# docker-compose Postgres.
# Row-level security (docs/database/rls.md): requests run as esmart_app, work across businesses
# as esmart_system, migrations and the db:* scripts as the owner. `npm run db:roles -w @esmart/db`
# creates the two roles; on a local database their passwords are their names.
DATABASE_URL=postgres://esmart_app:esmart_app@localhost:5432/esmart
SYSTEM_DATABASE_URL=postgres://esmart_system:esmart_system@localhost:5432/esmart
MIGRATION_DATABASE_URL=postgres://esmart:esmart@localhost:5432/esmart
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
# The web app: password-reset and invitation links open here.
APP_URL=http://localhost:8081
# Production refuses '*': list the web and admin origins, comma-separated. It must include APP_URL's origin.
CORS_ORIGINS=*
# Production refuses http:// and localhost for APP_URL and PUBLIC_BASE_URL.
# Proxies in front of the API whose X-Forwarded-For entry is believed (Railway: 1).
# TRUST_PROXY_HOPS=1
# Requests per minute: per user once signed in, per IP before; and per IP for sign-in, sign-up, OTP and password reset.
# RATE_LIMIT_PER_MINUTE=1200
# AUTH_RATE_LIMIT_PER_MINUTE=10
# Background jobs (src/jobs): inline (in this process, the default), only (jobs and /health, no API), off.
# WORKER=inline
# WORKER_CONCURRENCY=2
# The 8-year purge of closed accounts only logs what it would erase while this is true (the default).
# PURGE_DRY_RUN=true
# Nightly pg_dump into object storage. Needs a pg_dump at least as new as the server (docs/RUNBOOK.md).
# DB_BACKUP_ENABLED=false
# Accept 123456 as the OTP. Development only; production refuses it.
DEMO_OTP=true
# Comma-separated test numbers: OTP is always 123456 and no SMS/WhatsApp is sent. Allowed in production.
# TEST_OTP_PHONES=9876543210,9123456780

# The demo account ("Vertex Traders", acct_elixir_demo). `db:migrate` seeds it
# after the reference data when SEED_DEMO_ACCOUNT=true, in any environment;
# an existing demo account is left alone (`db:seed -- --reset` rebuilds it).
# The password is required; in production it must be at least 12 characters
# and not demo1234.
# SEED_DEMO_ACCOUNT=true
# DEMO_ACCOUNT_EMAIL=gowtham@vertextraders.in
# DEMO_ACCOUNT_PASSWORD=demo1234

# The public "Give it a try" demo (src/demo): eight sample businesses, one per
# business type, on the Business plan, read-only for visitors. On by default:
# the API builds it at start-up when it is missing, and rebuilds it weekly or
# when its dataset changes (`npm run demo:seed -w @esmart/api -- --force` by hand).
# DEMO_ENABLED=false suspends it (signs everyone out; the data stays).
# The password is public on purpose (the sign-in screen fills it in).
# DEMO_ENABLED=true
# DEMO_EMAIL=demo@elixir-books.com
# DEMO_PASSWORD=TryElixirBooks@2026

# Production must set these.
# JWT_SECRET=
# CREDENTIALS_KEY=   # 32 random bytes, base64: openssl rand -base64 32

# Providers default to in-process simulators and log-only senders, for
# development and tests. With NODE_ENV=production the API refuses to start
# until every one below is a real provider with its credentials, the webhook
# secrets are set, and CORS_ORIGINS is not '*'.
# SMS_PROVIDER=msg91        MSG91_AUTH_KEY=  MSG91_TEMPLATE_ID=
# SMS_PROVIDER=pay4sms      PAY4SMS_TOKEN=   # OTP only; sender and DLT template are fixed in code
# EMAIL_PROVIDER=resend     RESEND_API_KEY=  EMAIL_FROM=Elixir Books <noreply@your-verified-domain>   # onboarding@resend.dev only delivers to your own Resend login
# EMAIL_PROVIDER=acs        ACS_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>  EMAIL_FROM=Elixir Books <DoNotReply@<guid>.azurecomm.net>   # the sender from the Email Communication Service's domain (the free Azure-managed one needs no DNS)
# EMAIL_REPLY_TO=support@your-company.com   # optional, any provider
# EMAIL_PROVIDER=ses        EMAIL_FROM=  AWS_ACCESS_KEY_ID=  AWS_SECRET_ACCESS_KEY=
# WHATSAPP_PROVIDER=meta    WHATSAPP_TOKEN=  WHATSAPP_PHONE_NUMBER_ID=  WHATSAPP_WEBHOOK_SECRET=
# PUSH_PROVIDER=expo
# STORAGE_PROVIDER=azure    AZURE_STORAGE_CONNECTION_STRING=  AZURE_STORAGE_CONTAINER=esmart
# STORAGE_PROVIDER=s3       S3_BUCKET=  S3_REGION=  S3_ENDPOINT=  S3_FORCE_PATH_STYLE=
# PDF_PROVIDER=chromium     CHROMIUM_PATH=
# COMPLIANCE_PROVIDER=gsp   # e-invoice + e-way bill through a GSP; see the GSP block below
# RETURNS_PROVIDER=gsp      # GSTR-2B, saving and filing GSTR-1/3B through Adaequare's taxpayer API (routes unconfirmed); `disabled` to prepare only
# GST_FILING_ENABLED=false  # keep off until a CA signs off and the sandbox run passes
# GSTIN_PROVIDER=gsp        # GSTIN search through the same GSP. `disabled` answers 503 FEATURE_UNAVAILABLE
# OCR has no real adapter yet: `disabled` answers 503 FEATURE_UNAVAILABLE (OCR still
# parses text the phone read) and is the production setting until Document AI exists.
# OCR_PROVIDER=disabled
# FX_PROVIDER=openexchangerates  OPENEXCHANGERATES_APP_ID=
# PAYMENTS_PROVIDER=razorpay     RAZORPAY_KEY_ID=  RAZORPAY_KEY_SECRET=  RAZORPAY_WEBHOOK_SECRET=
# ASSISTANT_PROVIDER=anthropic  ANTHROPIC_API_KEY=  LIXI_MODEL=claude-opus-5-5  LIXI_EFFORT=low
# ASSISTANT_PROVIDER=openai     OPENAI_BASE_URL=https://openrouter.ai/api/v1  OPENAI_API_KEY=  LIXI_MODEL=openai/gpt-5-mini
#   LIXI_SECONDARY_MODEL= is tried when LIXI_MODEL fails. On OpenRouter, an unset one falls back to a
#   built-in free model (LIXI_DEFAULT_MODELS in src/config.ts: nvidia/nemotron-3-ultra-550b-a55b:free,
#   then google/gemma-4-31b-it:free). Free models have daily caps and may log prompts: set paid ones for customers.
#   OpenRouter reports each call's cost; it is recorded in ai_usage and shown in the admin console.
#   Any OpenAI-compatible server works; change OPENAI_BASE_URL and LIXI_MODEL:
#   OpenAI https://api.openai.com/v1 · Groq https://api.groq.com/openai/v1
#   Gemini https://generativelanguage.googleapis.com/v1beta/openai · DeepSeek https://api.deepseek.com/v1
#   Azure https://<resource>.openai.azure.com/openai/v1 (LIXI_MODEL = deployment name) · Ollama http://localhost:11434/v1 (no key)
#   OPENAI_RESPONSE_FORMAT=json_schema|json_object|none   OPENAI_REASONING_EFFORT=low (reasoning models only)

# ---------------------------------------------------------------------------
# GSP gateway: e-invoice (IRN), e-way bill and GSTIN search through Adaequare
# or Whitebooks. Read when COMPLIANCE_PROVIDER or GSTIN_PROVIDER is `gsp`; see
# src/providers/gsp/README.md. The names follow the Elixir Books platform's
# taxation service.
#
# Fill in EVERY provider below, side by side. Switching GSP is then one line:
#   TAXATION_GSP_PROVIDER_CODE=ADAEQUARE_GSP | WHITE_BOOKS_GSP
# That one value picks the e-invoice, e-way bill and lookup halves together.
#
# Two credentials per filing. The client id/secret below are OURS, from the
# environment: the app never asks a business for them. A business enters only its
# NIC portal username and password, which are saved through the app and sealed
# with CREDENTIALS_KEY.
# ---------------------------------------------------------------------------

# COMPLIANCE_PROVIDER=gsp
# GSTIN_PROVIDER=gsp
# TAXATION_GSP_PROVIDER_CODE=ADAEQUARE_GSP

# Leave blank in normal use (the code above decides). Set `adaequare` or
# `whitebooks` only when the code names neither.
# TAXATION_TAXPAYER_PROVIDER=

# ----- Adaequare (production-ready) -----
# Sandbox https://gsp.adaequare.com/test/   Production https://gsp.adaequare.com/
# One pair, used for everything.
# TAXATION_ADAEQUARE_BASE_URL=
# TAXATION_ADAEQUARE_APP_ID=
# TAXATION_ADAEQUARE_APP_SECRET=

# ----- Whitebooks (SANDBOX ONLY: refused at boot when NODE_ENV=production) -----
# TAXATION_WHITEBOOKS_BASE_URL=https://apisandbox.whitebooks.in
# The Whitebooks account email (sent as ?email=) and the public IP this server files from, as registered with it.
# TAXATION_WHITEBOOKS_ACCOUNT_EMAIL=
# TAXATION_WHITEBOOKS_IP_ADDRESS=
# Whitebooks issues a SEPARATE pair per product API. Blank skips that product (its calls then
# fail naming the variable); a half-set pair is refused at boot.
# TAXATION_WHITEBOOKS_APP_ID=                 # GST taxpayer lookup
# TAXATION_WHITEBOOKS_APP_SECRET=
# TAXATION_WHITEBOOKS_EINVOICE_APP_ID=        # IRN generate/cancel, and e-way bill by IRN
# TAXATION_WHITEBOOKS_EINVOICE_APP_SECRET=
# TAXATION_WHITEBOOKS_EWAYBILL_APP_ID=        # standalone e-way bill API
# TAXATION_WHITEBOOKS_EWAYBILL_APP_SECRET=

# The platform's un-prefixed names (TAXATION_GSP_BASE_URL, TAXATION_GSP_APP_ID/_SECRET,
# TAXATION_GSP_EINVOICE_APP_*, TAXATION_GSP_EWAYBILL_APP_*, TAXATION_GSP_ACCOUNT_EMAIL,
# TAXATION_GSP_IP_ADDRESS) and the older GSP_BASE_URL are still read, but only for
# a value the provider-specific variable above leaves blank.

# ----- Sandbox only. TAXATION_GSTIN_ALLOW_SANDBOX is the one switch for NIC's sandbox, and the -----
# deployment's own choice: it does not look at NODE_ENV, so a hosted staging deployment may use it. Without it
# the app refuses to start with the Whitebooks gateway, the test buyer, or the unauthenticated gateway below.
# Leave it unset on a live deployment.
# true admits NIC's sandbox GSTIN shape (a real PAN with 000 as the last three characters, 29AAGCB1286Q000),
# which fails the strict check-digit rule, and allows the sandbox-only settings below.
# TAXATION_GSTIN_ALLOW_SANDBOX=false
# Whitebooks only: file every e-invoice against this test buyer, looked up from
# NIC's register, because the sandbox refuses any buyer it has not registered
# (3028). The customer's own invoice and PDF are untouched. NIC's sample: 29AWGPV7107B1Z1.
# TAXATION_SANDBOX_BUYER_GSTIN=
# false skips the Adaequare token exchange, for a stand-in gateway that mints nothing.
# Leave it true on the real Adaequare, sandbox or production: with false it sends no bearer.
# TAXATION_GSP_AUTH_REQUIRED=true

# ----- API docs. Swagger UI at /docs and the contract at /docs/openapi.json, behind HTTP Basic with -----
# these. Unset: open in development, and off (404) in production. The password needs 12+ characters.
# DOCS_USERNAME=
# DOCS_PASSWORD=

# ----- Product analytics: PostHog Cloud, EU region. Unset key: events stay in memory (development, tests). -----
# Only IDs and categories are sent (see packages/core/src/analytics/events.ts); never amounts, names or
# tax numbers. Nothing is sent for the demo or for anyone who turned "Share usage data" off.
# POSTHOG_API_KEY=phc_
# POSTHOG_HOST=https://eu.i.posthog.com
# ANALYTICS_ENABLED=true
