{
  "name": "@esmart/api",
  "version": "0.1.0",
  "private": true,
  "description": "The Elixir Books API: Fastify, routed and validated from the OpenAPI contract, on Postgres via Drizzle.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.3",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/client-sesv2": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@esmart/api-contract": "*",
    "@esmart/core": "*",
    "@esmart/db": "*",
    "@esmart/i18n": "*",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-raw-body": "^6.0.1",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@esmart/eslint-config": "*",
    "@esmart/tsconfig": "*",
    "@types/node": "^22",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
