{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elixir Books Smart",
  "version": "1.0.0",
  "identifier": "com.elixir.bookssmart.desktop",
  "build": {
    "devUrl": "http://localhost:8081",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": { "script": "npm run dev -- --port 8081", "cwd": "../../web" },
    "beforeBuildCommand": { "script": "npm run build -- --clear", "cwd": "../../web" }
  },
  "app": {
    "windows": [
      {
        "title": "Elixir Books Smart",
        "width": 1366,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Invoicing, purchases, inventory, GST and accounts",
    "longDescription": "Invoicing, purchases, inventory, GST and accounts for small businesses.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
