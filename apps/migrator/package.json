{
  "name": "@esmart/migrator",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop tool that brings a business's existing data (an Excel or CSV file, later Elixir Books and other platforms) into Elixir Books Smart.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@esmart/api-client": "*",
    "@esmart/api-contract": "*",
    "@esmart/core": "*",
    "@tauri-apps/api": "^2.0.0",
    "exceljs": "^4.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@esmart/tsconfig": "*",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "~6.0.3",
    "vite": "8.3.1",
    "vitest": "^5.0.2"
  }
}
