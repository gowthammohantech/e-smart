{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elixir Books Smart Migrator",
  "version": "1.0.0",
  "identifier": "com.elixir.bookssmart.migrator",
  "build": {
    "devUrl": "http://localhost:5175",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Elixir Books Smart Migrator",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "category": "Business",
    "shortDescription": "Bring your existing data into Elixir Books Smart",
    "longDescription": "Import customers, suppliers and items from an Excel or CSV file into Elixir Books Smart.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0", "entitlements": "Entitlements.plist" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
