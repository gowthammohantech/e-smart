// ---------------------------------------------------------------------
// Tenancy and identity: Account -> Company -> Branch -> User
// ---------------------------------------------------------------------

Table accounts {
  id varchar(40) [pk, note: 'CustomerAccount; owns companies and users']
  name varchar(200) [not null]
  owner_user_id varchar(40) [note: 'set once the first user exists']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table companies {
  id varchar(40) [pk]
  account_id varchar(40) [not null, ref: > accounts.id]
  name varchar(200) [not null]
  legal_name varchar(200)
  logo_attachment_id varchar(40) [ref: > attachments.id]
  business_type varchar(40) [not null, note: 'stable slug, e.g. wholesale']
  country char(2) [not null, ref: > countries.code]
  base_currency char(3) [not null, ref: > currencies.code]
  address_line1 varchar(200) [not null]
  address_line2 varchar(200)
  address_city varchar(100) [not null]
  address_state varchar(100) [not null]
  address_state_code varchar(2) [note: 'GST state code, e.g. 27']
  address_postal_code varchar(12) [not null]
  address_country char(2) [not null]
  email varchar(254)
  phone varchar(20)
  website varchar(200)
  tax_regime tax_regime [not null, default: 'NONE']
  tax_identifier varchar(20) [note: 'GSTIN / TRN / VAT number']
  tax_identifier_label varchar(20) [not null, default: 'GSTIN']
  tax_registered boolean [not null, default: false]
  composition_scheme boolean [not null, default: false]
  place_of_supply_state_code varchar(2)
  fiscal_year_start_month smallint [not null, default: 4, note: '1-12']
  plan plan_tier [not null, default: 'free', note: 'changed only through billing']
  onboarding_completed_at timestamptz
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    account_id
    tax_identifier
  }
}

Table branches {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  name varchar(200) [not null]
  code varchar(6) [not null, note: 'e.g. MUM; used in numbering']
  address_line1 varchar(200) [not null]
  address_line2 varchar(200)
  address_city varchar(100) [not null]
  address_state varchar(100) [not null]
  address_state_code varchar(2)
  address_postal_code varchar(12) [not null]
  address_country char(2) [not null]
  is_primary boolean [not null, default: false, note: 'exactly one per company']
  phone varchar(20)
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, code) [unique]
  }
}

Table users {
  id varchar(40) [pk]
  account_id varchar(40) [not null, ref: > accounts.id]
  name varchar(200) [not null]
  email varchar(254) [not null, unique]
  phone varchar(20) [unique, note: 'E.164']
  password_hash varchar(255) [note: 'argon2id; null for OTP-only users']
  role user_role [not null, default: 'viewer']
  avatar_color varchar(9) [not null]
  status user_status [not null, default: 'invited']
  locale varchar(10) [default: 'en']
  default_company_id varchar(40) [ref: > companies.id]
  email_verified_at timestamptz
  phone_verified_at timestamptz
  last_active_at timestamptz
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    account_id
  }
}

Table user_companies {
  user_id varchar(40) [not null, ref: > users.id]
  company_id varchar(40) [not null, ref: > companies.id]

  indexes {
    (user_id, company_id) [pk]
  }
  Note: 'User.companyIds'
}

Table user_branches {
  user_id varchar(40) [not null, ref: > users.id]
  branch_id varchar(40) [not null, ref: > branches.id]

  indexes {
    (user_id, branch_id) [pk]
  }
  Note: 'User.branchIds. No rows for a company means all of its branches.'
}

Table invites {
  id varchar(40) [pk]
  user_id varchar(40) [not null, ref: > users.id]
  invited_by varchar(40) [not null, ref: > users.id]
  token_hash varchar(128) [not null, unique]
  expires_at timestamptz [not null]
  accepted_at timestamptz
  last_sent_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
}

Table otp_requests {
  id varchar(40) [pk, note: 'requestId returned to the client']
  phone varchar(20) [not null]
  channel otp_channel [not null, default: 'sms']
  code_hash varchar(128) [not null]
  attempts smallint [not null, default: 0]
  expires_at timestamptz [not null]
  verified_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (phone, created_at)
  }
}

Table password_reset_tokens {
  id varchar(40) [pk]
  user_id varchar(40) [not null, ref: > users.id]
  token_hash varchar(128) [not null, unique]
  expires_at timestamptz [not null]
  used_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table device_sessions {
  id varchar(40) [pk]
  user_id varchar(40) [not null, ref: > users.id]
  label varchar(100) [not null, note: "e.g. Priya's iPhone"]
  platform varchar(40) [not null]
  app_version varchar(20)
  location varchar(100)
  ip_address inet
  refresh_token_hash varchar(128) [not null, unique, note: 'rotated on every refresh']
  refresh_expires_at timestamptz [not null]
  last_active_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
  }
  Note: 'DeviceSession. `current` is computed per request.'
}

Table push_tokens {
  token varchar(255) [pk]
  user_id varchar(40) [not null, ref: > users.id]
  device_session_id varchar(40) [ref: > device_sessions.id]
  provider push_provider [not null]
  created_at timestamptz [not null, default: `now()`]
  last_used_at timestamptz
}

// ---------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------

Table plans {
  key plan_tier [pk]
  name varchar(40) [not null]
  monthly_price_minor bigint [not null]
  yearly_price_minor bigint [not null]
  currency char(3) [not null, default: 'INR']
  features jsonb [not null, note: 'marketing bullet list']
  popular boolean [not null, default: false]
  sort_order smallint [not null]
}

Table plan_modules {
  plan plan_tier [not null, ref: > plans.key]
  module plan_module [not null]

  indexes {
    (plan, module) [pk]
  }
  Note: 'Which gated modules a plan includes. Mirrors src/domain/plan.ts.'
}

Table subscriptions {
  company_id varchar(40) [pk, ref: - companies.id]
  plan plan_tier [not null, ref: > plans.key]
  cycle billing_cycle [not null]
  status subscription_status [not null, default: 'none']
  provider billing_provider
  provider_subscription_id varchar(100) [unique]
  provider_customer_id varchar(100)
  current_period_start timestamptz
  current_period_end timestamptz
  cancel_at_period_end boolean [not null, default: false]
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table subscription_events {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  from_plan plan_tier
  to_plan plan_tier
  event varchar(60) [not null, note: 'checkout.started, subscription.charged, …']
  webhook_event_id varchar(40) [ref: > webhook_events.id]
  created_at timestamptz [not null, default: `now()`]
}

// ---------------------------------------------------------------------
// Settings masters
// ---------------------------------------------------------------------

Table tax_categories {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  name varchar(100) [not null]
  rate numeric(6,3) [not null, note: 'combined percentage; split into components at calculation time']
  type tax_type [not null]
  hsn_code varchar(8) [ref: > hsn_codes.code]
  effective_from date [not null]
  description text
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    company_id
  }
}

Table expense_categories {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  name varchar(100) [not null]
  icon varchar(40) [not null]
  color varchar(9) [not null]
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, name) [unique]
  }
}

Table payment_accounts {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  name varchar(100) [not null]
  type payment_account_type [not null]
  currency char(3) [not null, ref: > currencies.code]
  account_number varchar(40)
  opening_balance_minor bigint [not null, default: 0]
  is_default boolean [not null, default: false]
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    company_id
  }
}

Table exchange_rates {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  from_currency char(3) [not null, ref: > currencies.code]
  to_currency char(3) [not null, ref: > currencies.code]
  rate numeric(18,8) [not null]
  effective_from date [not null]
  source rate_source [not null, default: 'manual']
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, from_currency, to_currency, effective_from) [unique]
  }
}

Table transporters {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  name varchar(200) [not null]
  transporter_id varchar(15) [not null, note: '15-character GSTIN, or a TRANSIN']
  phone varchar(20)
  status active_status [not null, default: 'active']
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, transporter_id) [unique]
  }
}

Table numbering_series {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  kind numbering_kind [not null]
  prefix varchar(20) [not null]
  next_number int [not null, default: 1, note: 'never moves backwards; incremented under row lock']
  padding smallint [not null, default: 4]
  include_fiscal_year boolean [not null, default: false]
  include_branch_code boolean [not null, default: false]
  reset_policy reset_policy [not null, default: 'never']
  last_reset_at date
  version int [not null, default: 1]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, kind) [unique]
  }
}

Table compliance_settings {
  company_id varchar(40) [pk, ref: - companies.id]
  einvoice_enabled boolean [not null, default: false]
  annual_turnover_minor bigint [not null, default: 0]
  einvoice_turnover_threshold_minor bigint [not null]
  currency char(3) [not null, default: 'INR']
  reporting_window_days smallint [not null, default: 30]
  auto_generate_einvoice_on_finalise boolean [not null, default: false]
  irp_username varchar(100)
  irp_client_id_masked varchar(40) [note: 'display only, e.g. ELX-****-9F21']
  irp_environment irp_environment [not null, default: 'sandbox']
  eway_bill_enabled boolean [not null, default: false]
  eway_bill_threshold_minor bigint [not null, default: 5000000, note: 'Rs 50,000 in paise']
  auto_generate_eway_bill_on_finalise boolean [not null, default: false]
  default_transporter_id varchar(40) [ref: > transporters.id]
  default_distance_km int [not null, default: 0]
  default_transport_mode transport_mode [not null, default: 'road']
  default_vehicle_type vehicle_type [not null, default: 'regular']
  version int [not null, default: 1]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Separate from companies so saveCompany cannot clobber it.'
}

Table compliance_credentials {
  company_id varchar(40) [pk, ref: - companies.id]
  environment irp_environment [not null]
  gsp_provider varchar(40) [note: 'ClearTax, Masters India, IRIS, NIC']
  client_id_encrypted bytea [not null]
  client_secret_encrypted bytea [not null]
  password_encrypted bytea [not null]
  kms_key_id varchar(200) [not null]
  auth_token_encrypted bytea [note: 'cached portal session token']
  auth_token_expires_at timestamptz
  last_tested_at timestamptz
  last_test_ok boolean
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Write-only secrets, envelope-encrypted with KMS. Never returned by the API.'
}

Table backup_settings {
  company_id varchar(40) [pk, ref: - companies.id]
  automatic boolean [not null, default: false]
  frequency backup_frequency [not null, default: 'daily']
  destination backup_destination [not null, default: 'elixir-cloud']
  last_backup_at timestamptz
  version int [not null, default: 1]
  updated_at timestamptz [not null, default: `now()`]
}

// ---------------------------------------------------------------------
// Parties and catalog
// ---------------------------------------------------------------------

Table parties {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  kind party_kind [not null]
  name varchar(200) [not null]
  code varchar(20) [not null]
  display_name varchar(200)
  tax_id varchar(20) [note: 'GSTIN / TRN']
  gst_registration_type gst_registration_type [note: 'null reads as regular with a GSTIN, else unregistered']
  email varchar(254)
  phone varchar(20)
  currency char(3) [not null, ref: > currencies.code]
  billing_line1 varchar(200) [not null]
  billing_line2 varchar(200)
  billing_city varchar(100) [not null]
  billing_state varchar(100) [not null]
  billing_state_code varchar(2)
  billing_postal_code varchar(12) [not null]
  billing_country char(2) [not null]
  shipping_line1 varchar(200) [note: 'all shipping_* null means same as billing']
  shipping_line2 varchar(200)
  shipping_city varchar(100)
  shipping_state varchar(100)
  shipping_state_code varchar(2)
  shipping_postal_code varchar(12)
  shipping_country char(2)
  credit_limit_minor bigint [note: 'in the party currency']
  opening_balance_minor bigint [not null, default: 0, note: 'positive: customer owes us / we owe supplier']
  payment_terms_days smallint [not null, default: 0]
  notes text
  status active_status [not null, default: 'active']
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, code) [unique]
    (company_id, kind, status)
    (company_id, tax_id)
  }
}

Table items {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  sku varchar(40) [not null]
  name varchar(200) [not null]
  description text
  type item_type [not null]
  unit varchar(10) [not null, ref: > units.code]
  currency char(3) [not null, note: 'company base currency']
  sale_price_minor bigint [not null, default: 0]
  purchase_price_minor bigint [not null, default: 0]
  tax_category_id varchar(40) [not null, ref: > tax_categories.id]
  hsn_code varchar(8) [ref: > hsn_codes.code]
  barcode varchar(40)
  track_inventory boolean [not null, default: false]
  opening_stock numeric(18,3) [not null, default: 0]
  reorder_level numeric(18,3) [not null, default: 0]
  image_attachment_id varchar(40) [ref: > attachments.id]
  status active_status [not null, default: 'active']
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, sku) [unique]
    (company_id, barcode)
    (company_id, status)
  }
}

// ---------------------------------------------------------------------
// Documents: quote, order, delivery, invoice, returns, PO, GRN, bill
// ---------------------------------------------------------------------

Table documents {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  branch_id varchar(40) [not null, ref: > branches.id]
  kind document_kind [not null]
  number varchar(40) [not null, note: '"<KIND>-DRAFT" until finalised']
  status doc_status [not null, default: 'draft']
  party_id varchar(40) [not null, ref: > parties.id]
  date date [not null]
  due_date date
  valid_until date
  reference varchar(100)
  supplier_doc_number varchar(40) [note: 'supplier bill number on purchase documents']
  currency char(3) [not null, ref: > currencies.code]
  exchange_rate numeric(18,8) [not null, default: 1, note: 'to company base currency']
  document_discount_mode discount_mode [not null, default: 'amount']
  document_discount_value numeric(18,4) [not null, default: 0]
  charges_minor bigint [not null, default: 0]
  apply_round_off boolean [not null, default: true]
  place_of_supply_state_code varchar(2)
  notes text
  terms text
  source_document_id varchar(40) [ref: > documents.id, note: 'e.g. invoice converted from a quote']

  // Totals, recomputed by the server on every write
  subtotal_minor bigint [not null, default: 0]
  line_discount_minor bigint [not null, default: 0]
  document_discount_minor bigint [not null, default: 0]
  taxable_amount_minor bigint [not null, default: 0]
  total_tax_minor bigint [not null, default: 0]
  round_off_minor bigint [not null, default: 0]
  grand_total_minor bigint [not null, default: 0]
  grand_total_base_minor bigint [not null, default: 0, note: 'in company base currency']
  amount_paid_minor bigint [not null, default: 0, note: 'sum of allocations; cached']

  // Denormalised e-way bill pointer (eway_bills is the source of truth)
  current_eway_bill_id varchar(40) [ref: > eway_bills.id]
  compliance_last_message text
  compliance_last_attempt_at timestamptz

  finalized_at timestamptz
  created_by varchar(40) [not null, ref: > users.id]
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, kind, number) [note: 'unique where status <> draft (partial index)']
    (company_id, kind, status, date)
    (company_id, party_id, date)
    (company_id, branch_id, date)
    source_document_id
  }
  Note: 'BusinessDocument. Only drafts may be deleted; everything else is cancelled so its number is kept.'
}

Table document_lines {
  id varchar(40) [pk]
  document_id varchar(40) [not null, ref: > documents.id]
  position smallint [not null]
  item_id varchar(40) [ref: > items.id, note: 'null for free-text lines']
  name varchar(200) [not null]
  description text
  hsn_code varchar(8)
  quantity numeric(18,3) [not null]
  unit varchar(10) [not null]
  unit_price_minor bigint [not null, note: 'document currency']
  discount_mode discount_mode [not null, default: 'percent']
  discount_value numeric(18,4) [not null, default: 0]
  tax_category_id varchar(40) [not null, ref: > tax_categories.id]
  tax_rate numeric(6,3) [not null, note: 'snapshot, so historical documents stay reproducible']
  tax_inclusive boolean [not null, default: false]
  line_total_minor bigint [not null, default: 0, note: 'computed']

  indexes {
    (document_id, position) [unique]
    item_id
  }
}

Table document_tax_lines {
  id varchar(40) [pk]
  document_id varchar(40) [not null, ref: > documents.id]
  tax_category_id varchar(40) [not null, ref: > tax_categories.id]
  category_name varchar(100) [not null, note: 'snapshot']
  rate numeric(6,3) [not null]
  taxable_amount_minor bigint [not null]
  total_tax_minor bigint [not null]

  indexes {
    (document_id, tax_category_id) [unique]
  }
  Note: 'DocumentTotals.taxLines, one per tax category on the document'
}

Table document_tax_components {
  id varchar(40) [pk]
  tax_line_id varchar(40) [not null, ref: > document_tax_lines.id]
  type tax_type [not null]
  label varchar(20) [not null, note: 'e.g. CGST 9%']
  rate numeric(6,3) [not null]
  amount_minor bigint [not null]
  Note: 'TaxLine.components: CGST+SGST intra-state, IGST inter-state, CESS'
}

Table e_invoices {
  document_id varchar(40) [pk, ref: - documents.id]
  company_id varchar(40) [not null, ref: > companies.id]
  status einvoice_status [not null, default: 'pending']
  doc_type einvoice_doc_type
  supply_type einvoice_supply_type
  irn char(64) [unique, note: 'lowercase hex digest from the IRP']
  ack_no varchar(20)
  ack_date varchar(19) [note: 'yyyy-MM-dd HH:mm:ss, as returned']
  signed_qr_payload text [note: 'JWS compact serialisation']
  signed_invoice text
  generated_at timestamptz
  cancelled_at timestamptz
  cancel_reason_code cancel_reason_code
  cancel_remark varchar(100)
  issues jsonb [note: 'ComplianceIssue[] from the last attempt']
  request_payload jsonb [note: 'NIC schema 1.1 payload sent']
  response_payload jsonb
  attempts smallint [not null, default: 0]
  last_attempt_at timestamptz
  version int [not null, default: 1]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, status)
  }
  Note: 'ComplianceInfo e-invoice fields, one per document'
}

Table share_links {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  document_id varchar(40) [not null, ref: > documents.id]
  token_hash varchar(128) [not null, unique]
  expires_at timestamptz [not null]
  view_count int [not null, default: 0]
  last_viewed_at timestamptz
  created_by varchar(40) [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
}

Table payment_links {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  document_id varchar(40) [not null, ref: > documents.id]
  provider varchar(20) [not null, default: 'razorpay']
  provider_link_id varchar(100) [not null, unique]
  url varchar(500) [not null]
  upi_uri varchar(500)
  amount_minor bigint [not null]
  currency char(3) [not null]
  status link_status [not null, default: 'active']
  expires_at timestamptz
  paid_at timestamptz
  payment_id varchar(40) [ref: > payments.id, note: 'set by the razorpay webhook']
  created_by varchar(40) [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
}

// ---------------------------------------------------------------------
// Compliance: e-way bills
// ---------------------------------------------------------------------

Table eway_bills {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  branch_id varchar(40) [not null, ref: > branches.id]
  eway_bill_number char(12) [not null, unique, note: 'issued by the portal']

  // Part-A
  document_id varchar(40) [not null, ref: > documents.id]
  document_kind document_kind [not null]
  document_number varchar(40) [not null]
  document_date date [not null]
  party_id varchar(40) [not null, ref: > parties.id]
  doc_type eway_doc_type [not null]
  supply_type eway_supply_type [not null]
  sub_supply_type eway_sub_supply_type [not null]
  sub_supply_description varchar(100) [note: 'required when sub_supply_type = others']
  transaction_type smallint [not null, note: '1 regular, 2 bill-to ship-to, 3 bill-from dispatch-from, 4 combination']

  from_legal_name varchar(200) [not null]
  from_gstin varchar(15) [not null, note: 'GSTIN or URP']
  from_address1 varchar(200) [not null]
  from_address2 varchar(200)
  from_place varchar(100) [not null]
  from_pincode char(6) [not null]
  from_state_code varchar(2) [not null]
  to_legal_name varchar(200) [not null]
  to_gstin varchar(15) [not null]
  to_address1 varchar(200) [not null]
  to_address2 varchar(200)
  to_place varchar(100) [not null]
  to_pincode char(6) [not null]
  to_state_code varchar(2) [not null]

  currency char(3) [not null, default: 'INR']
  consignment_value_minor bigint [not null]
  taxable_value_minor bigint [not null]
  cgst_minor bigint [not null, default: 0]
  sgst_minor bigint [not null, default: 0]
  igst_minor bigint [not null, default: 0]
  main_hsn_code varchar(8)
  item_count smallint [not null]

  // Part-B (current values; history in eway_bill_part_b_updates)
  transporter_id varchar(40) [ref: > transporters.id]
  transporter_name varchar(200)
  transport_mode transport_mode [not null]
  vehicle_number varchar(15)
  vehicle_type vehicle_type [not null, default: 'regular']
  transport_doc_number varchar(20)
  transport_doc_date date
  distance_km int [not null]

  // Lifecycle
  generated_at timestamptz [not null]
  generated_by varchar(40) [not null, ref: > users.id]
  valid_from timestamptz [not null]
  valid_upto timestamptz [not null, note: 'end of day, rule 138(10)']
  status eway_stored_status [not null, default: 'active']
  cancelled_at timestamptz
  cancel_reason_code cancel_reason_code
  cancel_remark varchar(100)

  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, status, valid_upto)
    document_id
    (company_id, party_id)
  }
  Note: 'A document may have several over time (cancel and regenerate).'
}

Table eway_bill_part_b_updates {
  id varchar(40) [pk]
  eway_bill_id varchar(40) [not null, ref: > eway_bills.id]
  mode transport_mode [not null]
  vehicle_number varchar(15)
  vehicle_type vehicle_type [not null]
  transport_doc_number varchar(20)
  transport_doc_date date
  from_place varchar(100) [not null]
  from_state_code varchar(2) [not null]
  reason_code eway_part_b_reason [not null]
  remark varchar(100)
  updated_by varchar(40) [not null, ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (eway_bill_id, updated_at)
  }
  Note: 'Append-only'
}

Table eway_bill_extensions {
  id varchar(40) [pk]
  eway_bill_id varchar(40) [not null, ref: > eway_bills.id]
  reason_code eway_extend_reason [not null]
  remark varchar(100)
  transit_type eway_transit_type [not null]
  current_place varchar(100) [not null]
  current_pincode char(6) [not null]
  current_state_code varchar(2) [not null]
  remaining_distance_km int [not null]
  previous_valid_upto timestamptz [not null]
  new_valid_upto timestamptz [not null]
  extended_by varchar(40) [not null, ref: > users.id]
  extended_at timestamptz [not null, default: `now()`]

  indexes {
    (eway_bill_id, extended_at)
  }
  Note: 'Append-only'
}

// ---------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------

Table payments {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  branch_id varchar(40) [not null, ref: > branches.id]
  number varchar(40) [not null]
  direction payment_direction [not null]
  party_id varchar(40) [not null, ref: > parties.id]
  date date [not null]
  amount_minor bigint [not null]
  currency char(3) [not null, ref: > currencies.code]
  exchange_rate numeric(18,8) [not null, default: 1]
  method payment_method [not null]
  reference varchar(100)
  account_id varchar(40) [not null, ref: > payment_accounts.id]
  unallocated_minor bigint [not null, default: 0, note: 'advance held against the party']
  fx_gain_loss_minor bigint [note: 'base currency']
  notes text
  created_by varchar(40) [not null, ref: > users.id]
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, number) [unique]
    (company_id, party_id, date)
    (company_id, direction, date)
    account_id
  }
}

Table payment_allocations {
  id varchar(40) [pk]
  payment_id varchar(40) [not null, ref: > payments.id]
  document_id varchar(40) [not null, ref: > documents.id]
  document_number varchar(40) [not null, note: 'snapshot']
  amount_minor bigint [not null, note: 'payment currency']

  indexes {
    (payment_id, document_id) [unique]
    document_id
  }
}

// ---------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------

Table expenses {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  branch_id varchar(40) [not null, ref: > branches.id]
  number varchar(40) [not null]
  category_id varchar(40) [not null, ref: > expense_categories.id]
  supplier_id varchar(40) [ref: > parties.id]
  date date [not null]
  amount_minor bigint [not null]
  currency char(3) [not null, ref: > currencies.code]
  exchange_rate numeric(18,8) [not null, default: 1]
  tax_category_id varchar(40) [ref: > tax_categories.id]
  tax_amount_minor bigint [not null, default: 0]
  tax_inclusive boolean [not null, default: true]
  account_id varchar(40) [not null, ref: > payment_accounts.id]
  method payment_method [not null]
  reference varchar(100)
  notes text
  billable boolean [not null, default: false]
  recurrence recurrence_frequency [not null, default: 'none']
  next_recurrence_date date
  recurring_parent_id varchar(40) [ref: > expenses.id, note: 'the template this occurrence was created from']
  ocr_extraction_id varchar(40) [ref: > ocr_extractions.id]
  created_by varchar(40) [not null, ref: > users.id]
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, number) [unique]
    (company_id, category_id, date)
    (company_id, date)
    next_recurrence_date [note: 'scheduler scan']
  }
}

// ---------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------

Table stock_movements {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  branch_id varchar(40) [not null, ref: > branches.id]
  item_id varchar(40) [not null, ref: > items.id]
  type stock_movement_type [not null]
  quantity numeric(18,3) [not null, note: 'signed; negative reduces stock']
  currency char(3) [not null]
  unit_cost_minor bigint [not null, default: 0]
  date date [not null]
  reference_type varchar(20) [note: 'document | adjustment | transfer']
  reference_id varchar(40) [note: 'document id for purchaseReceipt/salesIssue/returns']
  reference_number varchar(40)
  transfer_group_id varchar(40) [note: 'pairs transferOut with transferIn']
  adjust_reason stock_adjust_reason
  notes text
  created_by varchar(40) [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, item_id, branch_id, date)
    (company_id, branch_id, date)
    reference_id
    transfer_group_id
  }
  Note: 'Append-only ledger. Stock on hand = SUM(quantity) per item and branch.'
}

// ---------------------------------------------------------------------
// Files and OCR
// ---------------------------------------------------------------------

Table attachments {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  name varchar(255) [not null]
  mime_type varchar(100) [not null]
  size_bytes bigint [not null]
  storage_key varchar(500) [not null, note: 'object-store key; the API returns short-lived signed URLs']
  checksum_sha256 char(64)
  status attachment_status [not null, default: 'pending']
  entity_type varchar(30) [note: 'document | payment | expense | party | item | company (polymorphic)']
  entity_id varchar(40)
  uploaded_by varchar(40) [ref: > users.id]
  uploaded_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, entity_type, entity_id)
  }
  Note: 'Replaces the attachmentIds arrays on documents, payments and expenses.'
}

Table ocr_extractions {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  attachment_id varchar(40) [not null, ref: > attachments.id]
  kind ocr_kind [not null]
  status ocr_status [not null, default: 'queued']
  provider varchar(40)
  matched_party_id varchar(40) [ref: > parties.id]
  raw_response jsonb
  error text
  created_by varchar(40) [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (company_id, status)
  }
}

Table ocr_fields {
  id varchar(40) [pk]
  extraction_id varchar(40) [not null, ref: > ocr_extractions.id]
  key ocr_field_key [not null]
  label varchar(60) [not null]
  value text
  confidence numeric(4,3) [not null, note: 'below 0.75 is flagged for review']

  indexes {
    (extraction_id, key) [unique]
  }
}

Table ocr_lines {
  id varchar(40) [pk]
  extraction_id varchar(40) [not null, ref: > ocr_extractions.id]
  position smallint [not null]
  name varchar(200) [not null]
  quantity numeric(18,3)
  unit_price_minor bigint
  confidence numeric(4,3) [not null]
  matched_item_id varchar(40) [ref: > items.id]
}

// ---------------------------------------------------------------------
// Messaging: sends, reminders, delivery receipts
// ---------------------------------------------------------------------

Table message_deliveries {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  channel message_channel [not null]
  purpose varchar(30) [not null, note: 'documentSend | paymentReminder | invite | otp']
  recipient varchar(254) [not null, note: 'phone or email']
  party_id varchar(40) [ref: > parties.id]
  document_id varchar(40) [ref: > documents.id]
  message text
  include_payment_link boolean [not null, default: false]
  provider varchar(40)
  provider_message_id varchar(200) [unique]
  status delivery_status [not null, default: 'queued']
  error text
  sent_by varchar(40) [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  delivered_at timestamptz
  read_at timestamptz

  indexes {
    (company_id, party_id, created_at)
    document_id
  }
  Note: 'sendDocument and sendPaymentReminder; statuses updated by the WhatsApp webhook.'
}

Table reminder_documents {
  delivery_id varchar(40) [not null, ref: > message_deliveries.id]
  document_id varchar(40) [not null, ref: > documents.id]

  indexes {
    (delivery_id, document_id) [pk]
  }
  Note: 'A single reminder can cover several open invoices'
}

// ---------------------------------------------------------------------
// Notifications, audit, integrations, exports
// ---------------------------------------------------------------------

Table notifications {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  user_id varchar(40) [ref: > users.id, note: 'null means every member of the company']
  kind notification_kind [not null]
  title varchar(200) [not null]
  body text [not null]
  entity_type varchar(30)
  entity_id varchar(40)
  read_at timestamptz
  cleared_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, user_id, created_at)
  }
}

Table audit_events {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  actor_id varchar(40) [not null, ref: > users.id]
  actor_name varchar(200) [not null, note: 'snapshot']
  action varchar(60) [not null, note: 'e.g. marked sent']
  entity_type varchar(30) [not null]
  entity_id varchar(40) [not null]
  entity_label varchar(200) [not null]
  before jsonb
  after jsonb
  device varchar(100)
  ip_address inet
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, created_at)
    (company_id, entity_type, entity_id)
  }
  Note: 'Append-only; no updates or deletes'
}

Table integrations {
  id varchar(40) [pk, note: 'catalogue key, e.g. int_razorpay, int_drive']
  name varchar(100) [not null]
  description text [not null]
  icon varchar(40) [not null]
  category integration_category [not null]
  config_route varchar(100)
  min_plan plan_tier [not null, default: 'free']
}

Table company_integrations {
  company_id varchar(40) [not null, ref: > companies.id]
  integration_id varchar(40) [not null, ref: > integrations.id]
  connected boolean [not null, default: false]
  config jsonb
  credentials_encrypted bytea [note: 'OAuth tokens, API keys']
  connected_by varchar(40) [ref: > users.id]
  connected_at timestamptz
  disconnected_at timestamptz

  indexes {
    (company_id, integration_id) [pk]
  }
}

Table export_jobs {
  id varchar(40) [pk]
  company_id varchar(40) [not null, ref: > companies.id]
  format export_format [not null]
  status job_status [not null, default: 'queued']
  trigger varchar(20) [not null, default: 'manual', note: 'manual | scheduledBackup']
  storage_key varchar(500)
  expires_at timestamptz
  error text
  requested_by varchar(40) [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (company_id, created_at)
  }
}

// ---------------------------------------------------------------------
// Infrastructure: idempotency, offline sync, webhooks
// ---------------------------------------------------------------------

Table idempotency_keys {
  key uuid [not null]
  user_id varchar(40) [not null, ref: > users.id]
  method http_method [not null]
  path varchar(300) [not null]
  request_hash char(64) [not null]
  response_status smallint
  response_body jsonb
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, note: 'created_at + 24h']

  indexes {
    (user_id, key) [pk]
    expires_at
  }
}

Table sync_mutations {
  id varchar(40) [pk, note: 'client queue entry id; also the idempotency key']
  user_id varchar(40) [not null, ref: > users.id]
  company_id varchar(40) [ref: > companies.id]
  device_session_id varchar(40) [ref: > device_sessions.id]
  method http_method [not null]
  path varchar(300) [not null]
  body jsonb
  base_version int
  client_entity_id varchar(60)
  status sync_status [not null]
  result jsonb [note: 'response, or problem+json on conflict']
  queued_at timestamptz [not null]
  applied_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, applied_at)
  }
}

Table client_id_mappings {
  client_entity_id varchar(60) [not null, note: 'temporary id minted offline']
  user_id varchar(40) [not null, ref: > users.id]
  entity_type varchar(30) [not null]
  server_entity_id varchar(40) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, client_entity_id) [pk]
  }
}

Table change_log {
  seq bigserial [pk, note: 'monotonic cursor for /sync/pull']
  company_id varchar(40) [not null, ref: > companies.id]
  entity_type varchar(30) [not null]
  entity_id varchar(40) [not null]
  op varchar(10) [not null, note: 'upsert | delete']
  version int [not null]
  changed_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, seq)
  }
}

Table webhook_events {
  id varchar(40) [pk]
  source webhook_source [not null]
  external_event_id varchar(200) [not null]
  event_type varchar(60) [not null]
  signature_valid boolean [not null]
  payload jsonb [not null]
  processed_at timestamptz
  error text
  received_at timestamptz [not null, default: `now()`]

  indexes {
    (source, external_event_id) [unique, note: 'dedupes provider retries']
  }
}

// ---------------------------------------------------------------------
// Reference data (global, not tenant-scoped)
// ---------------------------------------------------------------------

Table countries {
  code char(2) [pk]
  name varchar(100) [not null]
  currency char(3) [not null, ref: > currencies.code]
  tax_regime tax_regime [not null]
  tax_id_label varchar(20) [not null]
  fiscal_year_start_month smallint [not null]
}

Table currencies {
  code char(3) [pk]
  name varchar(60) [not null]
  symbol varchar(8) [not null]
  minor_digits smallint [not null, default: 2, note: '3 for KWD/BHD, 0 for JPY']
}

Table states {
  country_code char(2) [not null, ref: > countries.code]
  code varchar(4) [not null, note: 'GST state code for IN, e.g. 27']
  name varchar(100) [not null]
  is_union_territory boolean [not null, default: false]

  indexes {
    (country_code, code) [pk]
  }
}

Table cities {
  id serial [pk]
  country_code char(2) [not null, ref: > countries.code]
  state_code varchar(4) [not null]
  name varchar(100) [not null]

  indexes {
    (country_code, state_code, name) [unique]
  }
}

Table pincodes {
  pincode char(6) [pk]
  city varchar(100) [not null]
  district varchar(100)
  state_code varchar(2) [not null]
  latitude numeric(9,6)
  longitude numeric(9,6)
  Note: 'India Post PIN directory'
}

Table units {
  code varchar(10) [pk, note: 'NIC UQC, e.g. NOS, KGS']
  name varchar(40) [not null]
  decimals smallint [not null, default: 0]
}

Table hsn_codes {
  code varchar(8) [pk]
  description text [not null]
  is_service boolean [not null, default: false, note: 'SAC codes start with 99']
  default_gst_rate numeric(6,3)
  Note: 'CBIC HSN/SAC master'
}

Table gstin_lookups {
  gstin varchar(15) [pk]
  legal_name varchar(200)
  trade_name varchar(200)
  status varchar(20) [note: 'Active, Cancelled, Suspended']
  registration_type gst_registration_type
  state_code varchar(2)
  address jsonb
  fetched_at timestamptz [not null, default: `now()`]
  Note: 'Cache of GST public search results'
}

// ---------------------------------------------------------------------
// Cross-table references not expressible inline
// ---------------------------------------------------------------------

Ref: accounts.owner_user_id > users.id
Ref: branches.address_country > countries.code

