// =====================================================================
// Elixir Books Smart: backend database schema
// Format: DBML. Paste into https://dbdiagram.io or run `npx @dbml/cli dbml2sql`.
//
// Sources: entity types in src/types/index.ts and the API contract in
// docs/api/openapi.yaml. Target engine: PostgreSQL 15+.
//
// Conventions
// - IDs are prefixed strings minted by the server (cmp_…, doc_…), varchar(40).
// - Money is two columns, *_minor bigint + a currency char(3). There are no floats.
//   Where a row has a single currency column, all its *_minor columns use it.
// - Mutable business rows carry version (optimistic concurrency, If-Match),
//   created_at and updated_at. Timestamps are timestamptz in UTC; dates are date.
// - Every business table carries company_id. Queries are always tenant-scoped.
// - Derived values (party balance, stock on hand, paid/partiallyPaid/overdue,
//   e-way bill `expired`) are computed, never set by clients.
// =====================================================================

Project elixir_books_smart {
  database_type: 'PostgreSQL'
  Note: 'Backend schema for Elixir Books Smart. Mirrors src/types/index.ts field for field, plus the server-only records the OpenAPI contract needs.'
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

Enum plan_tier {
  free
  basic
  pro
  business
}
Enum plan_module {
  purchases
  inventory
  expenses
  ocr
  fx
  branches
  payables
}
Enum user_role {
  owner
  admin
  accountant
  sales
  viewer
}
Enum user_status {
  active
  invited
  disabled
}
Enum active_status {
  active
  inactive
}
Enum tax_regime {
  GST
  VAT
  NONE
}
Enum party_kind {
  customer
  supplier
}
Enum gst_registration_type {
  regular
  composition
  unregistered
  sez
  overseas
}
Enum item_type {
  goods
  service
}
Enum tax_type {
  GST
  CGST
  SGST
  IGST
  VAT
  CESS
  NONE
}
Enum rate_source {
  manual
  provider
}
Enum discount_mode {
  percent
  amount
}

Enum document_kind {
  quote
  salesOrder
  delivery
  invoice
  salesReturn
  purchaseOrder
  goodsReceipt
  purchaseBill
  purchaseReturn
}

Enum doc_status {
  draft
  sent
  accepted
  rejected
  expired
  confirmed
  fulfilled
  cancelled
  delivered
  issued
  partiallyPaid [note: 'derived by the server']
  paid [note: 'derived by the server']
  overdue [note: 'derived by the server']
  requested
  approved
  processed
  received
  billed
}

Enum numbering_kind {
  quote
  salesOrder
  delivery
  invoice
  salesReturn
  purchaseOrder
  goodsReceipt
  purchaseBill
  purchaseReturn
  payment
  expense
}

Enum reset_policy {
