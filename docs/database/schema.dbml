  SEZWP
  SEZWOP
  EXPWP
  EXPWOP
  DEXP
}
Enum cancel_reason_code {
  "1" [note: 'duplicate']
  "2" [note: 'data entry mistake']
  "3" [note: 'order cancelled']
  "4" [note: 'others']
}
Enum irp_environment {
