          <div class="sub">HSN/SAC 04039010</div>
          
        </td>
        <td class="num">1 KGS</td>
        <td class="num">₹500.00</td>
        <td class="num">10%</td>
        <td class="num">18%</td>
        <td class="num strong">₹500.00</td>
      </tr><tr>
        <td class="num">3</td>
        <td>
          <div class="item">Butter</div>
          <div class="sub">HSN/SAC 04051000</div>
          
        </td>
        <td class="num">2.5 KGS</td>
        <td class="num">₹600.00</td>
        <td class="num">—</td>
        <td class="num">12%</td>
        <td class="num strong">₹1,500.00</td>
      </tr></tbody>
  </table>

  

  <table class="totals"><tbody><tr class=""><td>Subtotal</td><td class="num">₹3,000.00</td></tr><tr class=""><td>Line discounts</td><td class="num">− ₹50.00</td></tr><tr class=""><td>Taxable value</td><td class="num">₹2,950.00</td></tr><tr class="grand"><td>Total</td><td class="num">₹2,950.00</td></tr></tbody></table>
  <div class="words"><span class="cap">Amount in words</span> Rupees Two Thousand Nine Hundred Fifty Only</div>

  

  <div class="notes">
    <div>
      
