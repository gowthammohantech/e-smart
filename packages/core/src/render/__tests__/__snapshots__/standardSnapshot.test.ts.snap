        <td class="num">12%</td>
        <td class="num strong">₹1,500.00</td>
      </tr></tbody>
  </table>

  

  <table class="totals"><tbody><tr class=""><td>Subtotal</td><td class="num">₹3,000.00</td></tr><tr class=""><td>Line discounts</td><td class="num">− ₹50.00</td></tr><tr class=""><td>Freight and other charges</td><td class="num">₹100.00</td></tr><tr class=""><td>Taxable value</td><td class="num">₹3,050.00</td></tr><tr class="grand"><td>Total</td><td class="num">₹3,050.00</td></tr></tbody></table>
  <div class="words"><span class="cap">Amount in words</span> Rupees Three Thousand Fifty Only</div>

  

  <div class="notes">
