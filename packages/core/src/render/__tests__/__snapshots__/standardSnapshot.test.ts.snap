  <table class="totals"><tbody><tr class=""><td>Subtotal</td><td class="num">₹2,000.00</td></tr><tr class=""><td>Taxable value</td><td class="num">₹2,000.00</td></tr><tr class="grand"><td>Total</td><td class="num">₹2,000.00</td></tr></tbody></table>
  <div class="words"><span class="cap">Amount in words</span> Rupees Two Thousand Only</div>

  

  <div class="notes">
    <div>
      
      <div class="cap">Notes</div><div>Sales to B2C customer</div>
      <div class="cap" style="margin-top:12px">Terms &amp; conditions</div><div class="muted">Payment within 30 days.</div>
    </div>
    <div class="bank">
