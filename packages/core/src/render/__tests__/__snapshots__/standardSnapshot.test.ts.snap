exports[`the standard page is unchanged proforma 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>PROFORMA INVOICE SI/2026-27/0035</title>
<style>
  * { box-sizing: border-box; }
  body {
    /* The Tamil faces sit after the Latin ones, so Latin text is unchanged and
       Tamil glyphs come from the platform font rather than rendering as tofu.
       Both print WebViews subset-embed what they use into the PDF, so no
       webfont is shipped. */
    font-family: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial,
                 "Noto Sans Tamil", "Tamil Sangam MN", Latha, sans-serif;
    color: #0E121A;
    margin: 0;
    padding: 28px;
    font-size: 12px;
    line-height: 1.45;
    background: #FFFFFF;
  }
  .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
  .brand { font-size: 19px; font-weight: 700; letter-spacing: -0.3px; }
  .logo { display: block; max-width: 160px; max-height: 56px; object-fit: contain; margin-bottom: 8px; }
  .muted { color: #5A6478; }
  .doc-title { font-size: 22px; font-weight: 700; letter-spacing: 1px; color: #007AFF; text-align: right; }
  .meta { text-align: right; margin-top: 6px; }
  .meta div { margin-bottom: 2px; }
  .rule { height: 2px; background: #007AFF; margin: 18px 0; border-radius: 1px; }
  .parties { display: flex; gap: 28px; margin-bottom: 18px; }
  .parties > div { flex: 1; }
  .cap { font-size: 10px; letter-spacing: 0.8px; text-transform: uppercase; color: #5A6478; margin-bottom: 5px; font-weight: 700; }
  .name { font-weight: 700; font-size: 13px; margin-bottom: 3px; }
  table { width: 100%; border-collapse: collapse; }
  thead th {
    background: #F4F6FA; text-align: left; padding: 8px 9px;
    font-size: 10px; letter-spacing: 0.6px; text-transform: uppercase; color: #5A6478;
    border-bottom: 1px solid #E2E8F1;
  }
  tbody td { padding: 9px; border-bottom: 1px solid #E2E8F1; vertical-align: top; }
  .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  thead th.num { text-align: right; }
  .item { font-weight: 600; }
  .sub { color: #5A6478; font-size: 10px; margin-top: 2px; }
  .strong { font-weight: 700; }
  .reimbursements { margin-top: 14px; }
  .totals { width: 280px; margin-left: auto; margin-top: 14px; }
  .totals td { padding: 5px 0; border: 0; }
  .totals tr.grand td { border-top: 1px solid #E2E8F1; padding-top: 9px; font-weight: 700; font-size: 15px; }
  .words { margin-top: 10px; text-align: right; font-size: 12px; }
  .notes { margin-top: 26px; display: flex; gap: 28px; }
  .notes > div { flex: 1; }
  .bank { flex: 1; page-break-inside: avoid; }
  .bank-body { display: flex; gap: 14px; align-items: flex-start; }
  .bank-rows td { padding: 2px 10px 2px 0; border: 0; font-size: 11px; }
  .upi-qr { text-align: center; font-size: 9px; max-width: 120px; }
  .upi-qr svg { display: block; margin: 0 auto 4px; }
  .sign { margin-top: 34px; text-align: right; }
  .sign .signature { display: block; margin: 8px 0 -34px auto; max-width: 180px; max-height: 60px; object-fit: contain; }
  .sign .line { margin-top: 42px; border-top: 1px solid #E2E8F1; display: inline-block; padding-top: 5px; min-width: 190px; }
  .foot { margin-top: 26px; text-align: center; color: #5A6478; font-size: 10px; }
  .badge { display: inline-block; padding: 3px 9px; border-radius: 99px; background: rgba(0,122,255,0.1); color: #007AFF; font-size: 10px; font-weight: 700; }
  .einv { display: flex; gap: 18px; margin-top: 16px; padding: 12px 14px; border: 1px solid #E2E8F1; border-radius: 6px; page-break-inside: avoid; }
  .einv-qr svg { display: block; }
  .einv-body { flex: 1; }
  .einv-grid { display: flex; gap: 26px; margin-top: 9px; }
  /* The English term printed under a Tamil label. */
  .alt { display: block; font-size: 8px; font-weight: 400; letter-spacing: 0.3px; opacity: 0.66; text-transform: none; }
  /* Tamil marks sit above and below the line and clip at the Latin leading. */
  body.ta { line-height: 1.62; }
  /* Tracking pulls Tamil vowel signs away from their letters; the Latin
     .alt line under each label keeps its own. */
  body.ta .brand, body.ta .doc-title, body.ta .cap, body.ta thead th, body.ta .cancelled-strip { letter-spacing: 0; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 10px; line-height: 1.5; word-break: break-all; letter-spacing: 0.2px; }
  .cancelled-strip { margin-bottom: 14px; padding: 8px 12px; border-radius: 5px; background: rgba(255,59,48,0.10); color: #C62F26; font-size: 11px; font-weight: 700; letter-spacing: 0.4px; }
</style>
</head>
<body class="en">
  
  <div class="head">
    <div>
      <img class="logo" src="https://example.com/logo.png" alt="Shakthi Finance &amp; Trading">
      <div class="brand">Shakthi Finance &amp; Trading</div>
      <div class="muted">4/166 Pappankadu<br/>Arakkulam Paruvai Post<br/>Tiruchendur 641662<br/>Tamil Nadu</div>
      <div class="muted">8925622257</div>
      <div class="muted">accounts@shakthi.example</div>
      <div style="margin-top:5px"><strong>GSTIN:</strong> 33NDTPS4034R1ZD</div>
    </div>
    <div>
      <div class="doc-title">PROFORMA INVOICE</div>
      <div class="muted">Not a tax invoice. A tax invoice follows on supply or on receipt of payment.</div>
      
      <div class="meta">
        <div><strong>SI/2026-27/0035</strong></div>
        <div class="muted">Date: 05 Nov 2026</div>
        <div class="muted">Due: 05 Dec 2026</div>
        <div class="muted">Valid until: 30 Nov 2026</div>
        
        
        
      </div>
    </div>
  </div>

  <div class="rule"></div>

  <div class="parties">
    <div>
      <div class="cap">Bill to</div>
      <div class="name">M/s. B2C Customer</div>
      <div class="muted">46A<br/>Chennai 600066<br/>Tamil Nadu</div>
      <div style="margin-top:4px"><strong>GSTIN:</strong> 33AAACB1234C1Z5</div>
      <div class="muted">9000000000</div>
      <div class="muted">buyer@example.com</div>
    </div>
    <div>
      <div class="cap">Place of supply</div><div>Tamil Nadu</div>
      <div class="cap" style="margin-top:10px">Reference</div><div>PO-778</div>
      
      
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th style="width:26px">#</th>
        <th>Description</th>
        <th class="num">Qty</th>
        <th class="num">Rate</th>
        <th class="num">Disc.</th>
        <th class="num">Tax</th>
        <th class="num">Amount</th>
      </tr>
    </thead>
    <tbody><tr>
        <td class="num">1</td>
        <td>
          <div class="item">Milk</div>
          <div class="sub">HSN/SAC 04011000</div>
          
        </td>
        <td class="num">1 Ltr</td>
        <td class="num">₹1,000.00</td>
        <td class="num">—</td>
        <td class="num">0%</td>
        <td class="num strong">₹1,000.00</td>
      </tr><tr>
        <td class="num">2</td>
        <td>
          <div class="item">Curd</div>
          <div class="sub">HSN/SAC 04039010</div>
          
        </td>
        <td class="num">1 KGS</td>
        <td class="num">₹500.00</td>
        <td class="num">10%</td>
        <td class="num">18%</td>
        <td class="num strong">₹500.00</td>
      </tr><tr>
        <td class="num">3</td>
        <td>
          <div class="item">Butter</div>
          <div class="sub">HSN/SAC 04051000</div>
          
        </td>
        <td class="num">2.5 KGS</td>
        <td class="num">₹600.00</td>
        <td class="num">—</td>
        <td class="num">12%</td>
        <td class="num strong">₹1,500.00</td>
      </tr></tbody>
  </table>

  

  <table class="totals"><tbody><tr class=""><td>Subtotal</td><td class="num">₹3,000.00</td></tr><tr class=""><td>Line discounts</td><td class="num">− ₹50.00</td></tr><tr class=""><td>Taxable value</td><td class="num">₹2,950.00</td></tr><tr class="grand"><td>Total</td><td class="num">₹2,950.00</td></tr></tbody></table>
  <div class="words"><span class="cap">Amount in words</span> Rupees Two Thousand Nine Hundred Fifty Only</div>

  

  <div class="notes">
    <div>
      
      <div class="cap">Notes</div><div>Sales to B2C customer</div>
      <div class="cap" style="margin-top:12px">Terms &amp; conditions</div><div class="muted">Payment within 30 days.</div>
    </div>
    <div class="bank">
      <div class="cap">Bank details</div>
      <div class="bank-body">
        <table class="bank-rows"><tbody>
          <tr><td class="muted">Account name</td><td>Shakthi Finance</td></tr>
          <tr><td class="muted">Bank</td><td>ICICI</td></tr>
          <tr><td class="muted">Account no.</td><td>987765678765</td></tr>
          <tr><td class="muted">IFSC</td><td>ICIC0000976</td></tr>
          <tr><td class="muted">Branch</td><td>Thirupur</td></tr>
