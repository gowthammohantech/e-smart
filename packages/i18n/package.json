  },
  "devDependencies": {
    "@esmart/eslint-config": "*",
    "@esmart/tsconfig": "*",
    "@swc/core": "^1.16.12",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.1",
    "typescript": "~6.0.3"
  }
